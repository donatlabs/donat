# The engine's GraphQL endpoint. Relative by default: nginx serves the panel
# and proxies /v1/ and /auth/ to the engine, so both share one origin — which
# is what makes the session cookie come back at all.
#VITE_DONAT_GRAPHQL_URL=/v1/graphql

# The role this panel runs as. Every deployment calls its operator role
# something — `admin`, `support`, `operator`, `staff` — so it is configuration.
#
# Naming it here grants nothing. This engine has no admin role: the header only
# selects among the roles the signed-in user's token already granted, and what
# that role may do is decided entirely by the per-role permissions in the
# deployment's own metadata. A role the deployment never declared sees nothing.
VITE_DONAT_ROLE=admin

# The deployments this panel serves, as a JSON array. Omit it and the panel
# serves one: VITE_DONAT_GRAPHQL_URL as VITE_DONAT_ROLE.
#
# A stand is a deployment seen through ONE role — two roles against the same
# endpoint are two stands, because they show different data and can do
# different things. `users` says how that deployment spells its people;
# omitted, a `users` table with `name` and `email` is assumed, read-only until
# `mapping.updatableFields` says otherwise.
#
#VITE_DONAT_STANDS=[
#  {"id":"eu","label":"EU","graphqlUrl":"https://eu.example/v1/graphql","role":"support",
#   "users":{"table":"customer","nameField":"name","emailField":"email",
#            "identityField":"customer_id",
#            "mapping":{"updatableFields":["name","email"]}}},
#  {"id":"us","label":"US","graphqlUrl":"https://us.example/v1/graphql","role":"admin"}
#]

# The engine's own login routes. It redirects to the deployment's identity
# provider and puts the resulting token in an HttpOnly cookie; it stores no
# users and issues no tokens of its own.
#VITE_DONAT_LOGIN_PATH=/auth/login
#VITE_DONAT_LOGOUT_PATH=/auth/logout
#VITE_DONAT_SESSION_PATH=/auth/session

# Render the login screen in this panel instead of sending the browser to the
# provider's page.
#
# The screen becomes ours; the protocol stays the provider's. `/idp/authorize`
# establishes a session at the provider, solves its proof of work and posts the
# credentials to its own endpoint — so its rate limiting, its password policy
# and its audit trail all still apply, and the panel never sees a token.
#
# It needs the provider reachable on this origin, which the engine does when
# `DONAT_OIDC.login_api` names it. Empty switches the screen off and the
# provider's own page back on; that is the default for every provider other
# than Rauthy. See README.md.
#VITE_DONAT_IDP_BASE=/auth/v1
