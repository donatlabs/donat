# Runs the example with a real identity provider instead of demo headers:
#
#   docker compose --env-file auth.env up
#
# It starts the `rauthy` service (see docker-compose.yml) and switches the
# engine into JWT mode with the mapping below. Without this file nothing
# changes: the variable is empty and JWT mode stays off.
COMPOSE_PROFILES=auth

# How a token from the IdP becomes session variables.
#
#   jwk_url   reached over the compose network; the engine refreshes the
#             signing keys from it in the background
#   issuer    what the IdP puts in `iss`, derived from its PUB_URL, i.e. the
#             address a browser uses — not the internal one
#   audience  must equal the client id in bootstrap/clients.json
#
# claims_map is a pure lookup: each session variable is either a JSON path
# into the token's claims or a literal. It performs no string surgery, and
# roles are matched exactly, which is why roles come from the `roles` claim
# rather than from prefixed groups.
#
#   x-donat-default-role  read from the token rather than written as a literal.
#                       A literal is granted to every valid token, because the
#                       default role — unlike a requested one — is not checked
#                       against the token's role set: only `X-Donat-Role` is.
#                       Taking the first role the token carries keeps the
#                       engine's promise that a session never holds a role its
#                       token did not grant, and means a client only needs
#                       `X-Donat-Role` to pick between several.
#
#   x-donat-user-id  <- the `customer_id` attribute, carried into the ACCESS
#                       token by the `donat` scope (bootstrap/scopes.json) from
#                       the per-user value in bootstrap/users.json. Custom
#                       attributes arrive nested under `custom`, hence the
#                       two-segment path. Every
#                       customer row filter in this example compares
#                       X-Donat-User-Id against customer.customer_id, so this
#                       one mapping is what makes a logged-in shopper see
#                       exactly their own carts and orders.
#
#                       The default matters: staff carry no customer_id, and
#                       without it their login would fail outright. An empty
#                       value matches no customer row.
PETSHOP_JWT_CONFIG={"jwk_url":"http://rauthy:8080/auth/v1/oidc/certs","issuer":"http://localhost:8081/auth/v1/","audience":"petshop","claims_map":{"x-donat-allowed-roles":{"path":"$.roles"},"x-donat-default-role":{"path":"$.roles[0]"},"x-donat-user-id":{"path":"$.custom.customer_id","default":""}}}

# The database and role the IdP uses inside the shared Postgres. Set here
# rather than in the compose file so the default run creates neither: the
# initdb script skips entirely when this is empty, and a deployment that never
# enables the profile is not left holding an unused login. Change it for
# anything beyond a demo.
RAUTHY_DB_PASSWORD=petshop-demo-rauthy-password
