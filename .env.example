# Every credential this stack uses, and nothing else.
#
#   make env                          # fills this out into .env
#   docker compose up -d --build
#
# The values here are deliberately **empty**. `docker-compose.yml` reads them
# and refuses to start without them, which is the point: a committed file with
# working secrets in it is a shared secret, and a shared secret in a repository
# everyone clones is the same problem as a default password — moved one step.
#
# `make env` copies this file and fills each blank with a fresh value. Filling
# them in by hand is fine too; each line says what it wants.

# The operator you sign in as, and the provider's own admin account.
# Must satisfy the provider's password policy: upper, lower, digit.
DONAT_ADMIN_PASSWORD=

# Postgres. Anything; nothing else reads it.
#   openssl rand -hex 16
DONAT_DB_PASSWORD=

# The identity provider's encryption key — it encrypts what it stores, so
# losing it means losing every secret it holds.
#   head -c 32 /dev/urandom | base64
DONAT_IDP_ENC_KEY=

# The secret half of the engine's API key for the provider. What that key is
# allowed to do is declared in docker-compose.yml, because that is
# documentation; this is the credential. At least 64 alphanumeric characters.
#   head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 72
DONAT_IDP_ADMIN_SECRET=

# Raft and internal API secrets for the provider's embedded storage.
#   head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32
DONAT_IDP_RAFT_SECRET=
DONAT_IDP_API_SECRET=

# Object storage: MinIO's root credentials, which are also the engine's key
# for it.
#   head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 20
DONAT_S3_KEY=
DONAT_S3_SECRET=

# Signs the upload and download URLs the engine hands out. Rotating it
# invalidates every URL already in flight.
#   head -c 32 /dev/urandom | base64
DONAT_FILE_SIGNING_SECRET=

# --- not secret, listed so the whole configuration is in one place ----------

# Where the panel is published.
#DONAT_ADMIN_PORT=5180
# Where MinIO is published — a browser uploads straight to it.
#DONAT_S3_PORT=9000
# Offer "create an account" on the sign-in screen. The provider decides whether
# anyone actually may (OPEN_USER_REG, off by default); this only says whether
# to show the form.
#DONAT_IDP_REGISTRATION=false
