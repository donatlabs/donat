/target
**/*.rs.bk
.env
__pycache__/
*.pyc
.venv/
# Vendored Donat test suite — not committed; see tests/donat/README.md
tests/donat/tests-py/
.DS_Store
*.log
.claude/agent-memory
.worktrees/
# Working specifications stay local: they are drafting material, not a
# published contract. Accepted decisions live in knowledgebase/.
specs/
tests-system/.stack/

# The UI is the repository's only JavaScript.
node_modules/
apps/ui/dist/

# System-test stands write their built binaries, pids and logs here.
tests-system-lending/.stack/
tests-system-lending/.venv/

# Scratch products built on this engine's stack. `examples/` is published
# material — someone reads it to learn how to run donat, so it is committed
# and kept working. `experiments/` is the opposite: unfinished apps that
# happen to live next to the engine while they are being tried out. Nothing
# in the repository may depend on it, and nothing in it is reviewed.
experiments/
