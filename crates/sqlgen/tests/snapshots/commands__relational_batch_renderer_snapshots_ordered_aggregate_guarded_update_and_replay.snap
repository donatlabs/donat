WITH "_cmd_guard_gate" AS MATERIALIZED (SELECT TRUE AS "ok" WHERE CASE WHEN (TRUE) THEN (TRUE) ELSE FALSE END), "_cmd_legacy_identity_gate" AS MATERIALIZED (SELECT TRUE AS "ok" FROM "_cmd_guard_gate" WHERE CASE WHEN EXISTS (SELECT 1 FROM "donat"."command_invocations" WHERE "command_identity" = 'legacy-unqualified:726573657276655f63617274' AND "command_name" = 'reserve_cart' AND "scope_hash" = decode(md5((jsonb_build_array(to_jsonb(('tenant-7')::"text")))::text), 'hex') AND "key" = (('"request-42"')::jsonb #>> '{}')) OR EXISTS (SELECT 1 FROM "donat"."command_invocation_claims" WHERE "command_identity" = 'legacy-unqualified:726573657276655f63617274' AND "command_name" = 'reserve_cart' AND "scope_hash" = decode(md5((jsonb_build_array(to_jsonb(('tenant-7')::"text")))::text), 'hex') AND "key" = (('"request-42"')::jsonb #>> '{}')) THEN ("donat"."raise_graphql_error"('validation-failed', '$.selectionSet.reserve_cart', 'legacy idempotency key cannot be replayed safely after command identity migration') IS NULL) ELSE TRUE END), "_cmd_claim" AS (INSERT INTO "donat"."command_invocation_claims" AS "_cmd_claim_target" ("command_identity", "command_name", "scope_hash", "key", "claim_state", "expires_at") SELECT 'v1:7:default12:reserve_cart8:customer', 'reserve_cart', decode(md5((jsonb_build_array(to_jsonb(('tenant-7')::"text")))::text), 'hex'), (('"request-42"')::jsonb #>> '{}'), 'first', statement_timestamp() + 60 * interval '1 second' FROM "_cmd_legacy_identity_gate" ON CONFLICT ("command_identity", "scope_hash", "key") DO UPDATE SET "claim_state" = CASE WHEN "_cmd_claim_target"."expires_at" <= statement_timestamp() THEN 'first' ELSE 'replay' END, "expires_at" = CASE WHEN "_cmd_claim_target"."expires_at" <= statement_timestamp() THEN EXCLUDED."expires_at" ELSE "_cmd_claim_target"."expires_at" END RETURNING "command_identity", "command_name", "scope_hash", "key", "claim_state"), "_cmd_step_0" AS MATERIALIZED (SELECT "_cmd_target"."line_id", "_cmd_target"."variant_id", "_cmd_target"."quantity", "_cmd_target"."unit_price_minor", "_cmd_target"."currency", "_cmd_target"."line_id" AS "_cmd_order_0", row_number() OVER (ORDER BY "_cmd_target"."line_id")::bigint AS "_cmd_ordinal" FROM "public"."cart_pricing" AS "_cmd_target" WHERE "_cmd_target"."cart_id" = (42)::"int4" AND "_cmd_target"."customer_id" = (7)::"int4" AND (EXISTS (SELECT 1 FROM "_cmd_legacy_identity_gate")) AND EXISTS (SELECT 1 FROM "_cmd_claim" WHERE "claim_state" = 'first') ORDER BY "_cmd_target"."line_id"), "_cmd_unique_order_gate_0" AS MATERIALIZED (SELECT TRUE AS "ok" WHERE CASE WHEN ((EXISTS (SELECT 1 FROM "_cmd_legacy_identity_gate")) AND EXISTS (SELECT 1 FROM "_cmd_claim" WHERE "claim_state" = 'first')) THEN CASE WHEN ((SELECT count(*) FROM "_cmd_step_0") <> (SELECT count(*) FROM (SELECT "_cmd_ordered_rows"."_cmd_order_0" FROM "_cmd_step_0" AS "_cmd_ordered_rows" GROUP BY "_cmd_ordered_rows"."_cmd_order_0") AS "_cmd_unique_order")) THEN (donat.raise_graphql_error('validation-failed', '$.selectionSet.reserve_cart', 'command select_many step ''priced_lines'' contains duplicate order keys') IS NULL) ELSE TRUE END ELSE FALSE END), "_cmd_non_empty_gate_0" AS MATERIALIZED (SELECT TRUE AS "ok" WHERE CASE WHEN (((EXISTS (SELECT 1 FROM "_cmd_legacy_identity_gate")) AND EXISTS (SELECT 1 FROM "_cmd_claim" WHERE "claim_state" = 'first')) AND EXISTS (SELECT 1 FROM "_cmd_unique_order_gate_0")) THEN CASE WHEN ((SELECT count(*) FROM "_cmd_step_0") = 0) THEN (donat.raise_graphql_error('validation-failed', '$.selectionSet.reserve_cart', 'command select_many step ''priced_lines'' requires at least one row') IS NULL) ELSE TRUE END ELSE FALSE END), "_cmd_step_1" AS (SELECT (count(*))::"int8" AS "line_count", (sum("_cmd_input"."unit_price_minor"))::"int8" AS "subtotal_minor", (min("_cmd_input"."unit_price_minor"))::"int8" AS "first_price", (max("_cmd_input"."unit_price_minor"))::"int8" AS "last_price", (count(DISTINCT "_cmd_input"."currency"))::"int8" AS "currency_count" FROM "_cmd_step_0" AS "_cmd_input" WHERE (((EXISTS (SELECT 1 FROM "_cmd_legacy_identity_gate")) AND EXISTS (SELECT 1 FROM "_cmd_claim" WHERE "claim_state" = 'first')) AND EXISTS (SELECT 1 FROM "_cmd_unique_order_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_non_empty_gate_0")), "_cmd_unique_input_gate_2" AS MATERIALIZED (SELECT TRUE AS "ok" WHERE CASE WHEN ((((EXISTS (SELECT 1 FROM "_cmd_legacy_identity_gate")) AND EXISTS (SELECT 1 FROM "_cmd_claim" WHERE "claim_state" = 'first')) AND EXISTS (SELECT 1 FROM "_cmd_unique_order_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_non_empty_gate_0")) THEN CASE WHEN ((SELECT count(*) FROM "_cmd_step_0") <> (SELECT count(*) FROM (SELECT "_cmd_input"."variant_id" FROM "_cmd_step_0" AS "_cmd_input" GROUP BY "_cmd_input"."variant_id") AS "_cmd_unique_input")) THEN (donat.raise_graphql_error('validation-failed', '$.selectionSet.reserve_cart', 'command update_many step ''reserve_stock'' contains duplicate input primary keys') IS NULL) ELSE TRUE END ELSE FALSE END), "_cmd_update_check_gate_2" AS MATERIALIZED (SELECT TRUE AS "ok" WHERE CASE WHEN (((((EXISTS (SELECT 1 FROM "_cmd_legacy_identity_gate")) AND EXISTS (SELECT 1 FROM "_cmd_claim" WHERE "claim_state" = 'first')) AND EXISTS (SELECT 1 FROM "_cmd_unique_order_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_non_empty_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_unique_input_gate_2")) THEN CASE WHEN (EXISTS (SELECT 1 FROM "public"."inventory_stock" AS "_cmd_target" JOIN "_cmd_step_0" AS "_cmd_input" ON "_cmd_target"."variant_id" = "_cmd_input"."variant_id" WHERE "_cmd_target"."variant_id" = "_cmd_input"."variant_id" AND "_cmd_target"."tenant_id" = (7)::"int4" AND ("_cmd_target"."on_hand" - "_cmd_target"."reserved" >= "_cmd_input"."quantity") IS NOT TRUE)) THEN (donat.raise_graphql_error('validation-failed', '$.selectionSet.reserve_cart', 'command update_many check rejected') IS NULL) ELSE TRUE END ELSE FALSE END), "_cmd_step_2_updated" AS (UPDATE "public"."inventory_stock" AS "_cmd_target" SET "reserved" = ("_cmd_target"."reserved" + "_cmd_input"."quantity")::"int4" FROM "_cmd_step_0" AS "_cmd_input" WHERE "_cmd_target"."variant_id" = "_cmd_input"."variant_id" AND "_cmd_target"."tenant_id" = (7)::"int4" AND ("_cmd_target"."on_hand" - "_cmd_target"."reserved" >= "_cmd_input"."quantity") IS TRUE AND (((((EXISTS (SELECT 1 FROM "_cmd_legacy_identity_gate")) AND EXISTS (SELECT 1 FROM "_cmd_claim" WHERE "claim_state" = 'first')) AND EXISTS (SELECT 1 FROM "_cmd_unique_order_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_non_empty_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_unique_input_gate_2")) AND EXISTS (SELECT 1 FROM "_cmd_update_check_gate_2") RETURNING "_cmd_target".*), "_cmd_step_2" AS (SELECT "_cmd_input"."_cmd_ordinal", "_cmd_updated".* FROM "_cmd_step_0" AS "_cmd_input" JOIN "_cmd_step_2_updated" AS "_cmd_updated" ON "_cmd_updated"."variant_id" = "_cmd_input"."variant_id" ORDER BY "_cmd_input"."_cmd_ordinal"), "_cmd_update_permission_gate_2" AS MATERIALIZED (SELECT TRUE AS "ok" WHERE CASE WHEN ((((((EXISTS (SELECT 1 FROM "_cmd_legacy_identity_gate")) AND EXISTS (SELECT 1 FROM "_cmd_claim" WHERE "claim_state" = 'first')) AND EXISTS (SELECT 1 FROM "_cmd_unique_order_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_non_empty_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_unique_input_gate_2")) AND EXISTS (SELECT 1 FROM "_cmd_update_check_gate_2")) THEN CASE WHEN ((SELECT count(*) FROM "_cmd_step_2" WHERE ("_cmd_step_2"."reserved" >= (0)::"int4") IS NOT TRUE) > 0) THEN (donat.check_violation('{"path":"$.selectionSet.reserve_cart","message":"check constraint of an insert/update permission has failed"}') IS NULL) ELSE TRUE END ELSE FALSE END), "_cmd_affected_each_gate_2" AS MATERIALIZED (SELECT TRUE AS "ok" WHERE CASE WHEN (((((((EXISTS (SELECT 1 FROM "_cmd_legacy_identity_gate")) AND EXISTS (SELECT 1 FROM "_cmd_claim" WHERE "claim_state" = 'first')) AND EXISTS (SELECT 1 FROM "_cmd_unique_order_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_non_empty_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_unique_input_gate_2")) AND EXISTS (SELECT 1 FROM "_cmd_update_check_gate_2")) AND EXISTS (SELECT 1 FROM "_cmd_update_permission_gate_2")) THEN CASE WHEN ((SELECT count(*) FROM (SELECT "_cmd_input"."variant_id" FROM "_cmd_step_0" AS "_cmd_input" GROUP BY "_cmd_input"."variant_id") AS "_cmd_exact_unique_input") <> (SELECT count(*) FROM "_cmd_step_0") OR (SELECT count(*) FROM "_cmd_step_2") <> (SELECT count(*) FROM "_cmd_step_0")) THEN (donat.raise_graphql_error('validation-failed', '$.selectionSet.reserve_cart', 'command update_many step ''reserve_stock'' did not affect every input row') IS NULL) ELSE TRUE END ELSE FALSE END), "_cmd_final_gate" AS MATERIALIZED (SELECT TRUE AS "ok" WHERE CASE WHEN ((((((((EXISTS (SELECT 1 FROM "_cmd_legacy_identity_gate")) AND EXISTS (SELECT 1 FROM "_cmd_claim" WHERE "claim_state" = 'first')) AND EXISTS (SELECT 1 FROM "_cmd_unique_order_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_non_empty_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_unique_input_gate_2")) AND EXISTS (SELECT 1 FROM "_cmd_update_check_gate_2")) AND EXISTS (SELECT 1 FROM "_cmd_update_permission_gate_2")) AND EXISTS (SELECT 1 FROM "_cmd_affected_each_gate_2")) THEN (TRUE) ELSE FALSE END), "_cmd_result" AS (SELECT (json_build_object('priced_lines', (SELECT coalesce(json_agg(json_build_object('line_id', "_cmd_step_0"."line_id", 'variant_id', "_cmd_step_0"."variant_id", 'quantity', "_cmd_step_0"."quantity", 'unit_price_minor', "_cmd_step_0"."unit_price_minor", 'currency', "_cmd_step_0"."currency") ORDER BY "_cmd_step_0"."_cmd_ordinal"), '[]'::json) FROM "_cmd_step_0"), 'totals', (SELECT json_build_object('line_count', "_cmd_step_1"."line_count", 'subtotal_minor', "_cmd_step_1"."subtotal_minor", 'first_price', "_cmd_step_1"."first_price", 'last_price', "_cmd_step_1"."last_price", 'currency_count', "_cmd_step_1"."currency_count") FROM "_cmd_step_1" LIMIT 1), 'reserved', (SELECT coalesce(json_agg(json_build_object('variant_id', "_cmd_step_2"."variant_id", 'reserved', "_cmd_step_2"."reserved") ORDER BY "_cmd_step_2"."_cmd_ordinal"), '[]'::json) FROM "_cmd_step_2")))::jsonb AS "result" FROM "_cmd_final_gate"), "_cmd_store_first" AS (INSERT INTO "donat"."command_invocations" ("command_identity", "command_name", "scope_hash", "key", "invocation_id", "input_fingerprint", "result", "status", "expires_at") SELECT "_cmd_claim"."command_identity", "_cmd_claim"."command_name", "_cmd_claim"."scope_hash", "_cmd_claim"."key", gen_random_uuid(), decode(md5((('{"cart_id":42}')::jsonb)::text), 'hex'), "_cmd_result"."result", 'succeeded', statement_timestamp() + 60 * interval '1 second' FROM "_cmd_claim" CROSS JOIN "_cmd_result" WHERE "_cmd_claim"."claim_state" = 'first' ON CONFLICT ("command_identity", "scope_hash", "key") DO UPDATE SET "invocation_id" = EXCLUDED."invocation_id", "input_fingerprint" = EXCLUDED."input_fingerprint", "result" = EXCLUDED."result", "status" = EXCLUDED."status", "expires_at" = EXCLUDED."expires_at" RETURNING "result", "input_fingerprint", "invocation_id"), "_cmd_store_replay" AS (INSERT INTO "donat"."command_invocations" ("command_identity", "command_name", "scope_hash", "key", "invocation_id", "input_fingerprint", "result", "status", "expires_at") SELECT "_cmd_claim"."command_identity", "_cmd_claim"."command_name", "_cmd_claim"."scope_hash", "_cmd_claim"."key", gen_random_uuid(), decode(md5((('{"cart_id":42}')::jsonb)::text), 'hex'), 'null'::jsonb, 'succeeded', statement_timestamp() + 60 * interval '1 second' FROM "_cmd_claim" WHERE "_cmd_claim"."claim_state" = 'replay' ON CONFLICT ("command_identity", "scope_hash", "key") DO UPDATE SET "key" = EXCLUDED."key" RETURNING "result", "input_fingerprint", "invocation_id"), "_cmd_invocation" AS (SELECT "result", "input_fingerprint", "invocation_id" FROM "_cmd_store_first" UNION ALL SELECT "result", "input_fingerprint", "invocation_id" FROM "_cmd_store_replay"), "_cmd_checked" AS (SELECT (CASE WHEN NOT EXISTS (SELECT 1 FROM "_cmd_invocation" WHERE "input_fingerprint" = decode(md5((('{"cart_id":42}')::jsonb)::text), 'hex')) THEN donat.raise_graphql_error('validation-failed', '$.selectionSet.reserve_cart', 'idempotency key was reused with different input') ELSE (SELECT "result" FROM "_cmd_invocation") END)::jsonb AS "result") SELECT json_build_object('priced_lines', (SELECT coalesce(jsonb_agg(CASE WHEN "_t0"."value" IS NULL OR "_t0"."value" = 'null'::jsonb THEN 'null'::jsonb ELSE (json_build_object('variant_id', ("_t0"."value" -> 'variant_id'), 'quantity', ("_t0"."value" -> 'quantity')))::jsonb END), '[]'::jsonb) FROM jsonb_array_elements(CASE WHEN jsonb_typeof(((SELECT "result" FROM "_cmd_checked") -> 'priced_lines')) = 'array' THEN ((SELECT "result" FROM "_cmd_checked") -> 'priced_lines') ELSE '[]'::jsonb END) AS "_t0"(value)), 'totals', CASE WHEN ((SELECT "result" FROM "_cmd_checked") -> 'totals') IS NULL OR ((SELECT "result" FROM "_cmd_checked") -> 'totals') = 'null'::jsonb THEN 'null'::jsonb ELSE (json_build_object('line_count', (((SELECT "result" FROM "_cmd_checked") -> 'totals') -> 'line_count'), 'subtotal_minor', (((SELECT "result" FROM "_cmd_checked") -> 'totals') -> 'subtotal_minor')))::jsonb END, 'reserved', (SELECT coalesce(jsonb_agg(CASE WHEN "_t1"."value" IS NULL OR "_t1"."value" = 'null'::jsonb THEN 'null'::jsonb ELSE (json_build_object('variant_id', ("_t1"."value" -> 'variant_id'), 'reserved', ("_t1"."value" -> 'reserved')))::jsonb END), '[]'::jsonb) FROM jsonb_array_elements(CASE WHEN jsonb_typeof(((SELECT "result" FROM "_cmd_checked") -> 'reserved')) = 'array' THEN ((SELECT "result" FROM "_cmd_checked") -> 'reserved') ELSE '[]'::jsonb END) AS "_t1"(value))) AS root
