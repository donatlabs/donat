---
source: crates/sqlgen/tests/commands.rs
expression: sql
---
WITH "_cmd_guard_gate" AS MATERIALIZED (SELECT TRUE AS "ok" WHERE CASE WHEN (TRUE) THEN (TRUE) ELSE FALSE END), "_cmd_step_0" AS (SELECT "_cmd_target"."token", "_cmd_target"."tenant_id" FROM "public"."invite" AS "_cmd_target" WHERE "_cmd_target"."token" = ('unguessable')::"text" AND EXISTS (SELECT 1 FROM "_cmd_guard_gate") LIMIT 1), "_cmd_required_gate_0" AS MATERIALIZED (SELECT TRUE AS "ok" WHERE CASE WHEN (EXISTS (SELECT 1 FROM "_cmd_guard_gate")) THEN CASE WHEN EXISTS (SELECT 1 FROM "_cmd_step_0") THEN TRUE ELSE (donat.raise_graphql_error('validation-failed', '$.selectionSet.accept_invite', 'command select_one step ''invite'' did not find a row') IS NULL) END ELSE FALSE END), "_cmd_step_1" AS MATERIALIZED (SELECT "_cmd_target"."tenant_id", "_cmd_target"."user_id", "_cmd_target"."tenant_id" AS "_cmd_order_0", row_number() OVER (ORDER BY "_cmd_target"."tenant_id")::bigint AS "_cmd_ordinal" FROM "public"."member" AS "_cmd_target" WHERE "_cmd_target"."user_id" = ('person')::"text" AND ("_cmd_target"."tenant_id" = (SELECT "tenant_id" FROM "_cmd_step_0" LIMIT 1) AND EXISTS (SELECT 1 FROM "public"."store" AS "_t0" WHERE ("_t0"."id" = (SELECT "tenant_id" FROM "_cmd_step_0" LIMIT 1) AND "_t0"."status" IN (('active')::"text")))) AND (EXISTS (SELECT 1 FROM "_cmd_guard_gate")) AND EXISTS (SELECT 1 FROM "_cmd_required_gate_0") ORDER BY "_cmd_target"."tenant_id"), "_cmd_unique_order_gate_1" AS MATERIALIZED (SELECT TRUE AS "ok" WHERE CASE WHEN ((EXISTS (SELECT 1 FROM "_cmd_guard_gate")) AND EXISTS (SELECT 1 FROM "_cmd_required_gate_0")) THEN CASE WHEN ((SELECT count(*) FROM "_cmd_step_1") <> (SELECT count(*) FROM (SELECT "_cmd_ordered_rows"."_cmd_order_0" FROM "_cmd_step_1" AS "_cmd_ordered_rows" GROUP BY "_cmd_ordered_rows"."_cmd_order_0") AS "_cmd_unique_order")) THEN (donat.raise_graphql_error('validation-failed', '$.selectionSet.accept_invite', 'command select_many step ''peek'' contains duplicate order keys') IS NULL) ELSE TRUE END ELSE FALSE END), "_cmd_step_2" AS (INSERT INTO "public"."member" ("user_id", "tenant_id") SELECT ('person')::"text", (SELECT "tenant_id" FROM "_cmd_step_0" LIMIT 1) WHERE ((EXISTS (SELECT 1 FROM "_cmd_guard_gate")) AND EXISTS (SELECT 1 FROM "_cmd_required_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_unique_order_gate_1") RETURNING *), "_cmd_final_gate" AS MATERIALIZED (SELECT TRUE AS "ok" WHERE CASE WHEN (((EXISTS (SELECT 1 FROM "_cmd_guard_gate")) AND EXISTS (SELECT 1 FROM "_cmd_required_gate_0")) AND EXISTS (SELECT 1 FROM "_cmd_unique_order_gate_1")) THEN (TRUE) ELSE FALSE END), "_cmd_result" AS (SELECT (json_build_object('joined', (SELECT "_cmd_step_2"."tenant_id" FROM "_cmd_step_2" LIMIT 1)))::jsonb AS "result" FROM "_cmd_final_gate"), "_cmd_checked" AS (SELECT (CASE WHEN (EXISTS (SELECT 1 FROM "_cmd_guard_gate")) AND ((SELECT count(*) FROM "_cmd_step_0") = 0) THEN donat.raise_graphql_error('validation-failed', '$.selectionSet.accept_invite', 'command select_one step ''invite'' did not find a row') ELSE CASE WHEN (EXISTS (SELECT 1 FROM "_cmd_guard_gate")) AND ((SELECT count(*) FROM "_cmd_step_2" WHERE (EXISTS (SELECT 1 FROM "public"."store" AS "_t1" WHERE ("_t1"."id" = (SELECT "tenant_id" FROM "_cmd_step_0" LIMIT 1) AND "_t1"."status" IN (('active')::"text")))) IS NOT TRUE) > 0) THEN donat.check_violation('{"path":"$.selectionSet.accept_invite","message":"check constraint of an insert/update permission has failed"}')::jsonb ELSE (SELECT "result" FROM "_cmd_result") END END)::jsonb AS "result") SELECT json_build_object('joined', ((SELECT "result" FROM "_cmd_checked") -> 'joined')) AS root
