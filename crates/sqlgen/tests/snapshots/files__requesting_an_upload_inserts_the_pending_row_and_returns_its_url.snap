source: crates/sqlgen/tests/files.rs
expression: sql
---
WITH "__donat_upload" AS (INSERT INTO donat.file_uploads (id, attachment, backend, object_key, file_name, media_type, declared_bytes, byte_size, state, session_role, session_key, expires_at) SELECT '33333333-3333-3333-3333-333333333333'::uuid, 'public.pet.photo', 'local', 'public.pet.photo/33333333-3333-3333-3333-333333333333', 'cat.png', 'image/png', 20481, NULL, 'pending', 'customer', 'u-1', to_timestamp(1754000900) WHERE (SELECT count(*) FROM donat.file_uploads b WHERE b.session_role = 'customer' AND b.session_key IS NOT DISTINCT FROM 'u-1' AND b.state = 'pending' AND b.expires_at > now()) < 20 AND (SELECT count(*) FROM donat.file_uploads b WHERE b.session_role = 'customer' AND b.session_key IS NOT DISTINCT FROM 'u-1' AND b.created_at > now() - interval '1 minute') < 60 RETURNING *) SELECT CASE WHEN (SELECT count(*) FROM "__donat_upload") = 0 THEN donat.raise_graphql_error('validation-failed', '$.selectionSet.donat_request_file_upload', 'too many upload requests')::json ELSE (SELECT json_build_object('id', "__donat_upload"."id", 'url', '/v1/files/upload/33333333-3333-3333-3333-333333333333?exp=1754000900&sig=abc', 'method', 'PUT', 'headers', json_build_array(json_build_object('name', 'Content-Type', 'value', 'image/png')), 'complete_url', NULL, 'expires_at', to_char(to_timestamp(1754000900) AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS"Z"')) FROM "__donat_upload") END AS root
